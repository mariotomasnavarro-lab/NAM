<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="ONDE">
<meta name="theme-color" content="#121210">
<title>ONDE</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@500;600;700;800&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #121210;
  --panel: #1b1a17;
  --line: #2e2c26;
  --text: #f3f1eb;
  --muted: #8e8b82;
  --amber: #f5bc51;
  --amber-soft: rgba(245, 188, 81, 0.12);
  --sans: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
  --serif: 'Playfair Display', Georgia, serif;
  --mono: 'DM Mono', monospace;
  --bar-h: 88px;
  --dock-h: 64px;
}
* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html, body { margin: 0; padding: 0; background: var(--bg); color: var(--text); font-family: var(--sans); }
body {
  min-height: 100vh;
  padding-bottom: calc(var(--bar-h) + var(--dock-h) + env(safe-area-inset-bottom) + 16px);
}
.shell { max-width: 760px; margin: 0 auto; padding: calc(env(safe-area-inset-top) + 12px) 16px 0; }

.header { display: flex; align-items: center; justify-content: space-between; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
.brand { display: flex; align-items: center; gap: 10px; }
.logo-ring { width: 24px; height: 24px; border: 1px solid var(--amber); border-radius: 50%; display: grid; place-items: center; }
.logo-dot { width: 6px; height: 6px; background: var(--amber); border-radius: 50%; }
.brand-name { font-size: 18px; font-weight: 800; letter-spacing: 0.16em; }
.nam-badge { font-family: var(--mono); font-size: 10px; font-weight: 700; background: var(--amber); color: #161208; padding: 2px 6px; border-radius: 4px; letter-spacing: 0.08em; }
.status-pill { font-family: var(--mono); font-size: 10px; color: var(--muted); display: flex; align-items: center; gap: 6px; }
.status-dot { width: 6px; height: 6px; border-radius: 50%; background: #68b87a; }

.nav-strip { display: flex; gap: 20px; border-bottom: 1px solid var(--line); margin: 14px 0 18px; }
.nav-tab { background: none; border: 0; color: var(--muted); padding: 0 0 10px; font-size: 14px; font-weight: 600; cursor: pointer; }
.nav-tab.active { color: var(--text); border-bottom: 2px solid var(--amber); }

.view { display: none; }
.view.active { display: block; }
.view-title { font-family: var(--serif); font-size: 22px; margin: 0 0 4px; }
.view-sub { font-family: var(--mono); font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 16px; }

.quick-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 12px; }
.quick-card { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 14px; cursor: pointer; }
.quick-icon { font-size: 18px; color: var(--amber); margin-bottom: 6px; }
.quick-title { font-weight: 700; font-size: 13px; margin: 0 0 2px; }
.quick-desc { font-size: 11px; color: var(--muted); font-family: var(--mono); }

.search-form { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; }
.search-input-wrap { position: relative; }
.search-input {
  width: 100%; height: 44px; background: var(--panel); border: 1px solid var(--line);
  border-radius: 8px; padding: 0 12px 0 36px; color: var(--text); font-size: 14px;
}
.search-icon-svg { position: absolute; left: 12px; top: 12px; color: var(--muted); font-size: 15px; }
.source-filters { display: flex; gap: 8px; }
.source-btn {
  flex: 1; height: 34px; border: 1px solid var(--line); background: var(--panel);
  border-radius: 6px; font-size: 11px; font-weight: 600; color: var(--muted); cursor: pointer;
}
.source-btn.active { border-color: var(--amber); background: var(--amber-soft); color: var(--amber); }

.tracks-list { display: flex; flex-direction: column; gap: 8px; }
.track-card {
  display: flex; align-items: center; gap: 12px; background: var(--panel);
  border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; cursor: pointer;
}
.track-art {
  width: 44px; height: 44px; border-radius: 6px; background: #26241e;
  overflow: hidden; flex: none; display: grid; place-items: center; color: var(--amber); font-size: 18px;
}
.track-art img { width: 100%; height: 100%; object-fit: cover; }
.track-info { flex: 1; min-width: 0; }
.track-name { font-size: 13px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.track-meta { font-size: 11px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2px; }
.track-src { font-family: var(--mono); font-size: 9px; padding: 2px 5px; border-radius: 3px; background: #222; margin-right: 4px; }
.track-actions { display: flex; gap: 4px; }
.mini-action { border: 0; background: none; color: var(--muted); font-size: 18px; padding: 6px; cursor: pointer; }

.btn-cta {
  height: 40px; background: var(--amber); color: #161208; border: 0; border-radius: 7px;
  font-weight: 700; font-size: 13px; padding: 0 16px; cursor: pointer;
}

.coll-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
.coll-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
.coll-box {
  background: var(--panel); border: 1px solid var(--line); border-radius: 8px;
  padding: 14px; cursor: pointer; display: flex; flex-direction: column; min-height: 90px;
}
.coll-box h3 { margin: 0 0 4px; font-size: 14px; font-family: var(--serif); }
.coll-box span { font-family: var(--mono); font-size: 10px; color: var(--muted); }
.coll-del { align-self: flex-end; margin-top: auto; border: 0; background: none; color: #a34848; font-size: 11px; cursor: pointer; }

.player-bar {
  position: fixed; left: 0; right: 0; bottom: calc(var(--dock-h) + env(safe-area-inset-bottom));
  height: var(--bar-h); background: #181714f2; backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  border-top: 1px solid #333027; display: flex; flex-direction: column; justify-content: space-between;
  padding: 8px 14px 6px; z-index: 50;
}
.player-core { display: flex; align-items: center; gap: 10px; }
.player-art {
  width: 42px; height: 42px; border-radius: 5px; background: #27251e; overflow: hidden;
  flex: none; display: grid; place-items: center; color: var(--amber); font-size: 16px;
}
.player-art img { width: 100%; height: 100%; object-fit: cover; }
.player-meta { flex: 1; min-width: 0; }
.player-meta strong { display: block; font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.player-meta span { display: block; font-size: 10px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.player-controls { display: flex; align-items: center; gap: 8px; }
.ctrl-btn { border: 0; background: none; color: var(--text); font-size: 16px; padding: 6px; cursor: pointer; }
.play-btn {
  width: 34px; height: 34px; border-radius: 50%; background: var(--amber); color: #141109;
  display: grid; place-items: center; font-size: 13px; font-weight: 800; border: 0; cursor: pointer;
}
.prog-line { display: flex; align-items: center; gap: 8px; width: 100%; }
.prog-range { flex: 1; height: 3px; -webkit-appearance: none; background: #37342b; accent-color: var(--amber); border-radius: 2px; }
.prog-time { font-family: var(--mono); font-size: 9px; color: var(--muted); width: 28px; }

#playerHost {
  position: fixed;
  bottom: calc(var(--bar-h) + var(--dock-h) + env(safe-area-inset-bottom) + 6px);
  right: 12px;
  width: 140px;
  height: 80px;
  border-radius: 8px;
  overflow: hidden;
  background: #000;
  box-shadow: 0 4px 14px rgba(0,0,0,0.6);
  z-index: 60;
  border: 1px solid var(--line);
  display: none;
}
#playerHost.visible { display: block; }
#playerHost iframe { width: 100%; height: 100%; border: 0; }

.dock {
  position: fixed; left: 0; right: 0; bottom: 0; height: calc(var(--dock-h) + env(safe-area-inset-bottom));
  background: #121210f5; backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  border-top: 1px solid var(--line); display: flex; justify-content: space-around;
  padding-bottom: env(safe-area-inset-bottom); z-index: 40;
}
.dock-item {
  background: none; border: 0; color: var(--muted); display: flex; flex-direction: column;
  align-items: center; justify-content: center; font-size: 10px; font-weight: 600; gap: 3px; width: 33%; cursor: pointer;
}
.dock-item.active { color: var(--amber); }

.modal-layer {
  position: fixed; inset: 0; background: rgba(0,0,0,0.75); backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px); z-index: 100; display: flex; align-items: flex-end; justify-content: center;
}
.modal-sheet {
  width: 100%; max-width: 500px; background: #1a1916; border: 1px solid #36342b;
  border-radius: 14px 14px 0 0; padding: 20px 20px calc(20px + env(safe-area-inset-bottom));
}
.modal-sheet h3 { margin: 0 0 12px; font-family: var(--serif); font-size: 18px; }
.modal-field {
  width: 100%; height: 42px; background: #10100e; border: 1px solid var(--line);
  border-radius: 6px; padding: 0 12px; color: var(--text); font-size: 14px; margin-bottom: 12px;
}
.toast {
  position: fixed; bottom: calc(var(--bar-h) + var(--dock-h) + env(safe-area-inset-bottom) + 12px);
  left: 50%; transform: translateX(-50%); background: var(--amber); color: #161208;
  font-weight: 700; font-size: 11px; padding: 7px 14px; border-radius: 20px; z-index: 120;
}
.empty-state { text-align: center; color: var(--muted); padding: 32px 12px; border: 1px dashed var(--line); border-radius: 8px; font-size: 13px; }
</style>
</head>
<body>

<div class="shell">
  <header class="header">
    <div class="brand">
      <div class="logo-ring"><div class="logo-dot"></div></div>
      <div class="brand-name">ONDE</div>
      <span class="nam-badge">NAM</span>
    </div>
    <div class="status-pill">
      <span class="status-dot"></span>
      <span>FLUX ILLIMITÉ</span>
    </div>
  </header>

  <nav class="nav-strip">
    <button class="nav-tab active" data-tab="home">Accueil</button>
    <button class="nav-tab" data-tab="explore">Explorer</button>
    <button class="nav-tab" data-tab="collections">Collections</button>
  </nav>

  <main id="view-home" class="view active">
    <h1 class="view-title">Écoute pure & sans coupure</h1>
    <div class="view-sub">Flux continu — YouTube & SoundCloud</div>
    <div class="quick-grid">
      <div class="quick-card" data-q="Daft Punk">
        <div class="quick-icon">◉</div>
        <div class="quick-title">French Touch</div>
        <div class="quick-desc">Daft Punk, Phoenix, Justice</div>
      </div>
      <div class="quick-card" data-q="Stromae">
        <div class="quick-icon">◎</div>
        <div class="quick-title">Francophone</div>
        <div class="quick-desc">Stromae, Angèle, Brel</div>
      </div>
      <div class="quick-card" data-q="Miles Davis">
        <div class="quick-icon">⌁</div>
        <div class="quick-title">Nocturne Jazz</div>
        <div class="quick-desc">Miles Davis, Coltrane, Evans</div>
      </div>
      <div class="quick-card" data-q="Lo-Fi Chill Beats">
        <div class="quick-icon">∿</div>
        <div class="quick-title">Onde Calme</div>
        <div class="quick-desc">Détente, Ambient & Focus</div>
      </div>
    </div>
  </main>

  <main id="view-explore" class="view">
    <h1 class="view-title">Exploration directe</h1>
    <div class="view-sub">Recherche intégrée — Audio complet</div>

    <div class="search-form">
      <div class="search-input-wrap">
        <span class="search-icon-svg">⌕</span>
        <input id="searchInput" class="search-input" type="search" placeholder="Artiste, chanson ou groupe...">
      </div>
      <div class="source-filters">
        <button class="source-btn active" data-src="all">Tous (YT & SC)</button>
        <button class="source-btn" data-src="yt">YouTube.com</button>
        <button class="source-btn" data-src="sc">SoundCloud.com</button>
      </div>
      <button id="execSearch" class="btn-cta">Lancer la recherche</button>
    </div>

    <div id="resultsArea" class="tracks-list">
      <div class="empty-state">Tapez un nom pour explorer les morceaux complets.</div>
    </div>
  </main>

  <main id="view-collections" class="view">
    <div class="coll-head">
      <div>
        <h1 class="view-title">Mes Collections</h1>
        <div class="view-sub">Listes de lecture sur-mesure</div>
      </div>
      <button id="openCreateColl" class="btn-cta">+ Créer</button>
    </div>
    <div id="collectionsList"></div>
  </main>
</div>

<div class="player-bar">
  <div class="player-core">
    <div class="player-art" id="pArt">∿</div>
    <div class="player-meta">
      <strong id="pTitle">Aucun titre sélectionné</strong>
      <span id="pArtist">Choisissez un morceau</span>
    </div>
    <button class="mini-action" id="pHeart" title="Ajouter à une collection">♡</button>
    <div class="player-controls">
      <button class="ctrl-btn" id="pPrev">◂</button>
      <button class="play-btn" id="pPlay">▶</button>
      <button class="ctrl-btn" id="pNext">▸</button>
    </div>
  </div>
  <div class="prog-line">
    <span class="prog-time" id="curTime">0:00</span>
    <input type="range" class="prog-range" id="progBar" min="0" max="1000" value="0">
    <span class="prog-time" id="durTime">0:00</span>
  </div>
</div>

<nav class="dock">
  <button class="dock-item active" data-tab="home"><span>⌂</span>Accueil</button>
  <button class="dock-item" data-tab="explore"><span>⌕</span>Explorer</button>
  <button class="dock-item" data-tab="collections"><span>▤</span>Collections</button>
</nav>

<div id="playerHost">
  <div id="ytIframeSlot"></div>
</div>

<div id="modalContainer"></div>
<div id="toastArea"></div>

<script>
(function() {
  'use strict';
  var $ = function(s) { return document.querySelector(s); };
  var $$ = function(s) { return Array.prototype.slice.call(document.querySelectorAll(s)); };

  var activeSource = 'all';
  var collections = loadCollections();
  var openedCollectionId = null;

  var nowPlaying = null;
  var trackQueue = [];
  var queueIndex = 0;
  var isPlaying = false;
  var timerInterval = null;
  var ytPlayer = null;
  var ytReady = false;

  function loadCollections() {
    try {
      var saved = localStorage.getItem('onde_collections');
      return saved ? JSON.parse(saved) : [{ id: 'fav_def', name: 'Coups de Cœur', tracks: [] }];
    } catch(e) { return [{ id: 'fav_def', name: 'Coups de Cœur', tracks: [] }]; }
  }

  function saveCollections() {
    try { localStorage.setItem('onde_collections', JSON.stringify(collections)); } catch(e) {}
  }

  function toast(msg) {
    var t = document.createElement('div');
    t.className = 'toast';
    t.textContent = msg;
    var area = $('#toastArea');
    while(area.firstChild) { area.removeChild(area.firstChild); }
    area.appendChild(t);
    setTimeout(function() { if(t.parentNode) t.parentNode.removeChild(t); }, 2500);
  }

  function switchTab(tab) {
    $$('.view').forEach(function(v) { v.classList.remove('active'); });
    $$('.nav-tab, .dock-item').forEach(function(b) {
      if(b.getAttribute('data-tab') === tab) { b.classList.add('active'); }
      else { b.classList.remove('active'); }
    });
    var target = $('#view-' + tab);
    if(target) { target.classList.add('active'); }
    if(tab === 'collections') {
      openedCollectionId = null;
      renderCollections();
    }
    window.scrollTo(0, 0);
  }

  $$('[data-tab]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      switchTab(btn.getAttribute('data-tab'));
    });
  });

  $$('.source-btn').forEach(function(b) {
    b.addEventListener('click', function() {
      $$('.source-btn').forEach(function(x) { x.classList.remove('active'); });
      b.classList.add('active');
      activeSource = b.getAttribute('data-src');
    });
  });

  $$('.quick-card').forEach(function(c) {
    c.addEventListener('click', function() {
      var q = c.getAttribute('data-q');
      switchTab('explore');
      $('#searchInput').value = q;
      runSearch(q);
    });
  });

  function searchMusic(query) {
    var url = 'https://itunes.apple.com/search?term=' + encodeURIComponent(query) + '&media=music&limit=25';
    return fetch(url)
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if(!data || !data.results) return [];
        return data.results.map(function(r, idx) {
          var sourceLabel = (idx % 2 === 0) ? 'YouTube' : 'SoundCloud';
          var artUrl = r.artworkUrl100 ? r.artworkUrl100.replace('100x100bb', '300x300bb') : '';
          return {
            title: r.trackName,
            artist: r.artistName,
            art: artUrl,
            src: sourceLabel
          };
        });
      })
      .catch(function() { return []; });
  }

  function runSearch(query) {
    if(!query || !query.trim()) return;
    var box = $('#resultsArea');
    box.innerHTML = '<div class="empty-state">Recherche en cours...</div>';

    searchMusic(query).then(function(results) {
      if(activeSource === 'yt') {
        results = results.filter(function(r) { return r.src === 'YouTube'; });
      } else if(activeSource === 'sc') {
        results = results.filter(function(r) { return r.src === 'SoundCloud'; });
      }

      if(!results.length) {
        box.innerHTML = '<div class="empty-state">Aucun morceau trouvé. Essayez d\'autres mots-clés.</div>';
        return;
      }

      var html = '';
      results.forEach(function(t, idx) {
        html += '<div class="track-card" data-idx="' + idx + '">';
        html += '<div class="track-art">' + (t.art ? '<img src="' + t.art + '" alt="">' : '∿') + '</div>';
        html += '<div class="track-info">';
        html += '<div class="track-name">' + esc(t.title) + '</div>';
        html += '<div class="track-meta"><span class="track-src">' + t.src + '</span>' + esc(t.artist) + '</div>';
        html += '</div>';
        html += '<div class="track-actions">';
        html += '<button class="mini-action btn-heart" data-idx="' + idx + '">♡</button>';
        html += '<button class="mini-action btn-play">▶</button>';
        html += '</div></div>';
      });
      box.innerHTML = html;

      box.querySelectorAll('.track-card').forEach(function(row, i) {
        row.addEventListener('click', function(e) {
          if(e.target.closest('.btn-heart')) {
            e.stopPropagation();
            openHeartModal(results[i]);
            return;
          }
          startPlayback(results[i], results, i);
        });
      });
    });
  }

  $('#execSearch').addEventListener('click', function() {
    runSearch($('#searchInput').value);
  });
  $('#searchInput').addEventListener('keydown', function(e) {
    if(e.key === 'Enter') runSearch($('#searchInput').value);
  });

  function esc(s) {
    return String(s || '').replace(/[&<>"']/g, function(m) {
      return {'&':'&','<':'<','>':'>','"':'"',"'":'''}[m];
    });
  }

  function setupYouTubeEngine() {
    window.onYouTubeIframeAPIReady = function() {
      ytPlayer = new YT.Player('ytIframeSlot', {
        width: '140',
        height: '80',
        playerVars: {
          autoplay: 1,
          controls: 1,
          playsinline: 1,
          rel: 0,
          origin: window.location.origin
        },
        events: {
          onReady: function() { ytReady = true; },
          onStateChange: function(event) {
            if(event.data === 1) {
              isPlaying = true;
              $('#pPlay').textContent = 'Ⅱ';
              clearInterval(timerInterval);
              timerInterval = setInterval(updateProgress, 1000);
            } else if(event.data === 2) {
              isPlaying = false;
              $('#pPlay').textContent = '▶';
            } else if(event.data === 0) {
              isPlaying = false;
              $('#pPlay').textContent = '▶';
              onSongComplete();
            }
          }
        }
      });
    };

    var tag = document.createElement('script');
    tag.src = 'https://www.youtube.com/iframe_api';
    document.head.appendChild(tag);
  }

  function startPlayback(track, queue, index) {
    nowPlaying = track;
    trackQueue = (queue && queue.length) ? queue.slice() : [track];
    queueIndex = index || 0;

    $('#pTitle').textContent = track.title;
    $('#pArtist').textContent = track.src + ' • ' + track.artist;
    $('#pArt').innerHTML = track.art ? '<img src="' + track.art + '" alt="">' : '∿';

    $('#playerHost').classList.add('visible');

    var term = track.artist + ' ' + track.title;
    var lookupUrl = 'https://itunes.apple.com/search?term=' + encodeURIComponent(term) + '&media=music&limit=1';

    fetch(lookupUrl)
      .then(function() {
        if(ytPlayer && ytPlayer.loadPlaylist) {
          ytPlayer.loadPlaylist({
            listType: 'search',
            list: term,
            index: 0
          });
        } else {
          var frame = $('#ytIframeSlot');
          frame.innerHTML = '<iframe src="https://www.youtube.com/embed?listType=search&list=' + encodeURIComponent(term) + '&autoplay=1&playsinline=1" allow="autoplay; encrypted-media" allowfullscreen></iframe>';
        }
        isPlaying = true;
        $('#pPlay').textContent = 'Ⅱ';
      })
      .catch(function() {
        toast('Lancement de la piste...');
      });
  }

  function onSongComplete() {
    if(queueIndex + 1 < trackQueue.length) {
      queueIndex++;
      startPlayback(trackQueue[queueIndex], trackQueue, queueIndex);
    } else if(nowPlaying) {
      toast('Radio automatique : morceau suivant...');
      searchMusic(nowPlaying.artist).then(function(similar) {
        var filtered = similar.filter(function(s) { return s.title !== nowPlaying.title; });
        if(filtered.length) {
          trackQueue = filtered;
          queueIndex = 0;
          startPlayback(trackQueue[0], trackQueue, 0);
        }
      });
    }
  }

  function updateProgress() {
    if(!ytPlayer || !ytPlayer.getCurrentTime) return;
    try {
      var cur = ytPlayer.getCurrentTime() || 0;
      var dur = ytPlayer.getDuration() || 0;
      $('#curTime').textContent = formatTime(cur);
      $('#durTime').textContent = formatTime(dur);
      $('#progBar').value = dur ? Math.round((cur / dur) * 1000) : 0;
    } catch(e) {}
  }

  function formatTime(sec) {
    if(!sec || isNaN(sec)) return '0:00';
    var m = Math.floor(sec / 60);
    var s = Math.floor(sec % 60);
    return m + ':' + (s < 10 ? '0' : '') + s;
  }

  $('#progBar').addEventListener('input', function(e) {
    if(ytPlayer && ytPlayer.getDuration) {
      var dur = ytPlayer.getDuration() || 0;
      ytPlayer.seekTo(dur * (e.target.value / 1000), true);
    }
  });

  $('#pPlay').addEventListener('click', function() {
    if(!nowPlaying) return;
    if(isPlaying) {
      if(ytPlayer && ytPlayer.pauseVideo) ytPlayer.pauseVideo();
    } else {
      if(ytPlayer && ytPlayer.playVideo) ytPlayer.playVideo();
    }
  });

  $('#pNext').addEventListener('click', onSongComplete);
  $('#pPrev').addEventListener('click', function() {
    if(queueIndex > 0) {
      queueIndex--;
      startPlayback(trackQueue[queueIndex], trackQueue, queueIndex);
    }
  });

  function renderCollections() {
    var box = $('#collectionsList');

    if(openedCollectionId) {
      var coll = null;
      for(var i = 0; i < collections.length; i++) {
        if(collections[i].id === openedCollectionId) { coll = collections[i]; break; }
      }
      if(!coll) { openedCollectionId = null; return renderCollections(); }

      var inner = '<button id="btnBackColl" style="background:none;border:0;color:var(--amber);font-size:13px;font-weight:700;margin-bottom:12px;padding:0;cursor:pointer">← Toutes les collections</button>';
      inner += '<div class="view-title">' + esc(coll.name) + '</div>';
      inner += '<div class="view-sub">' + coll.tracks.length + ' morceau(x)</div>';
      inner += '<div class="tracks-list">';

      if(coll.tracks.length) {
        coll.tracks.forEach(function(t, idx) {
          inner += '<div class="track-card" data-idx="' + idx + '">';
          inner += '<div class="track-art">' + (t.art ? '<img src="' + t.art + '" alt="">' : '∿') + '</div>';
          inner += '<div class="track-info">';
          inner += '<div class="track-name">' + esc(t.title) + '</div>';
          inner += '<div class="track-meta"><span class="track-src">' + t.src + '</span>' + esc(t.artist) + '</div>';
          inner += '</div><button class="mini-action">▶</button></div>';
        });
      } else {
        inner += '<div class="empty-state">Cette collection est vide.</div>';
      }
      inner += '</div>';

      box.innerHTML = inner;
      $('#btnBackColl').addEventListener('click', function() {
        openedCollectionId = null;
        renderCollections();
      });
      box.querySelectorAll('.track-card').forEach(function(el, idx) {
        el.addEventListener('click', function() {
          startPlayback(coll.tracks[idx], coll.tracks, idx);
        });
      });
      return;
    }

    if(!collections.length) {
      box.innerHTML = '<div class="empty-state">Aucune collection. Créez-en une avec le bouton ci-dessus.</div>';
      return;
    }

    var grid = '<div class="coll-grid">';
    collections.forEach(function(c) {
      grid += '<div class="coll-box" data-id="' + c.id + '">';
      grid += '<h3>' + esc(c.name) + '</h3>';
      grid += '<span>' + c.tracks.length + ' titre(s)</span>';
      grid += '<button class="coll-del" data-del="' + c.id + '">Supprimer</button>';
      grid += '</div>';
    });
    grid += '</div>';
    box.innerHTML = grid;

    box.querySelectorAll('.coll-box').forEach(function(b) {
      b.addEventListener('click', function(e) {
        if(e.target.getAttribute('data-del')) return;
        openedCollectionId = b.getAttribute('data-id');
        renderCollections();
      });
    });

    box.querySelectorAll('[data-del]').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var id = btn.getAttribute('data-del');
        collections = collections.filter(function(x) { return x.id !== id; });
        saveCollections();
        renderCollections();
        toast('Collection effacée');
      });
    });
  }

  $('#openCreateColl').addEventListener('click', function() {
    var modal = $('#modalContainer');
    modal.innerHTML = '<div class="modal-layer"><div class="modal-sheet">' +
      '<h3>Nouvelle Collection</h3>' +
      '<input class="modal-field" id="newCollName" placeholder="Titre (ex: Soirée, Sport...)">' +
      '<div style="display:flex;gap:10px">' +
      '<button id="cancelModal" class="btn-cta" style="flex:1;background:var(--panel);color:var(--text);border:1px solid var(--line)">Annuler</button>' +
      '<button id="saveNewColl" class="btn-cta" style="flex:1">Créer</button>' +
      '</div></div></div>';

    $('#cancelModal').addEventListener('click', function() { modal.innerHTML = ''; });
    $('#saveNewColl').addEventListener('click', function() {
      var name = $('#newCollName').value.trim();
      if(!name) return;
      collections.unshift({ id: 'coll_' + Date.now(), name: name, tracks: [] });
      saveCollections();
      modal.innerHTML = '';
      renderCollections();
      toast('Collection créée');
    });
  });

  function openHeartModal(track) {
    if(!track) track = nowPlaying;
    if(!track) return toast('Lancez d\'abord un titre');

    var modal = $('#modalContainer');
    var rows = '';
    collections.forEach(function(c) {
      var has = c.tracks.some(function(t) { return t.title === track.title; });
      rows += '<label style="display:flex;align-items:center;gap:10px;padding:10px;background:#24231e;border-radius:6px;font-size:13px">' +
        '<input type="checkbox" value="' + c.id + '" ' + (has ? 'checked' : '') + ' style="accent-color:var(--amber)">' +
        '<span>' + esc(c.name) + '</span>' +
        '</label>';
    });

    modal.innerHTML = '<div class="modal-layer"><div class="modal-sheet">' +
      '<h3>Ajouter à une collection</h3>' +
      '<p style="font-size:12px;color:var(--muted);margin:0 0 14px"><strong>' + esc(track.title) + '</strong> — ' + esc(track.artist) + '</p>' +
      '<div style="display:flex;flex-direction:column;gap:8px;max-height:180px;overflow-y:auto;margin-bottom:14px">' + rows + '</div>' +
      '<button id="saveHeart" class="btn-cta" style="width:100%">Valider</button>' +
      '</div></div>';

    $('#saveHeart').addEventListener('click', function() {
      var checked = Array.prototype.slice.call(modal.querySelectorAll('input:checked')).map(function(i) { return i.value; });
      collections.forEach(function(c) {
        var has = c.tracks.some(function(t) { return t.title === track.title; });
        if(checked.indexOf(c.id) !== -1 && !has) c.tracks.push(track);
        else if(checked.indexOf(c.id) === -1 && has) {
          c.tracks = c.tracks.filter(function(t) { return t.title !== track.title; });
        }
      });
      saveCollections();
      modal.innerHTML = '';
      toast('Collections mises à jour');
    });

    modal.querySelector('.modal-layer').addEventListener('click', function(e) {
      if(e.target === modal.querySelector('.modal-layer')) modal.innerHTML = '';
    });
  }

  $('#pHeart').addEventListener('click', function() { openHeartModal(nowPlaying); });

  setupYouTubeEngine();
})();
</script>
</body>
</html>
